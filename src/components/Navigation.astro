---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const url = new URL(Astro.request.url);
const lang = getLangFromUrl(url);
const t = useTranslations(lang);
const pathname = url.pathname;
const targetLang = lang === 'en' ? 'zh' : 'en';
const targetPath = pathname.replace(`/${lang}`, `/${targetLang}`);

const navItems = [
  { name: t('nav.blog'), href: `/${lang}/blog` },
  { name: t('nav.podcast'), href: `/${lang}/podcast` },
];

const isActive = (href: string) => pathname.startsWith(href);
---

<nav class="flex items-center gap-6 md:gap-10 font-serif">
  {navItems.map(item => (
    <a 
      href={item.href} 
      class={`text-base md:text-lg tracking-[0.2em] transition-all hover:text-[#b91c1c] ${
        isActive(item.href) ? 'text-[#b91c1c] font-bold border-b-2 border-[#b91c1c]' : 'text-gray-400'
      }`}
    >
      {item.name}
    </a>
  ))}
  
  <a href={targetPath} class="lang-btn font-sans text-[10px] border border-gray-300 px-2 py-0.5 rounded-sm hover:bg-black hover:text-white transition">
    {lang === 'en' ? 'ZH' : 'EN'}
  </a>
</nav>