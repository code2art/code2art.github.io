---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';

interface Props {
  title?: string;
  lang?: string;
}
const { title = "蚩尤 | 歧言謬語", lang = "zh" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;700;900&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#fcfaf2] overflow-x-hidden">
    <header class="max-w-5xl mx-auto px-6 md:px-10 pt-12 md:pt-20 mb-16 md:mb-28 border-b border-gray-200 pb-10 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-8">
      <div class="flex items-start gap-5">
        <a href={`/${lang}`} class="seal-logo font-serif">
          蚩尤
          <span class="seal-mark font-sans">印</span>
        </a>
        <div class="flex flex-col border-l border-gray-300 pl-5">
          <span class="text-sm md:text-base tracking-[0.5em] text-gray-500 font-serif font-bold italic">歧言謬語</span>
          <span class="text-[10px] md:text-[11px] text-gray-400 uppercase mt-1 font-sans">Qi Yan Miu Yu</span>
        </div>
      </div>
      <Navigation lang={lang} />
    </header>

    <main class="max-w-5xl mx-auto px-6 md:px-10">
      <slot />
    </main>

    <footer class="max-w-5xl mx-auto px-6 mt-40 pt-10 border-t border-gray-100 text-center pb-20">
      <p class="text-xs text-gray-400 font-serif tracking-widest leading-loose">
        {lang === 'zh' ? '© 貳零貳陸 蚩尤 ｜ 歧言謬語' : '© 2026 CHI YOU ｜ QI YAN MIU YU'}
      </p>
    </footer>

    <style>
      .seal-logo {
        position: relative;
        padding: 0.3rem 0.9rem;
        border: 2.5px solid #b91c1c;
        color: #b91c1c;
        font-weight: bold;
        line-height: 1;
        font-size: 2.2rem;
        letter-spacing: -0.05em;
        text-decoration: none;
        display: inline-block;
        transition: all 0.1s ease-in-out;
      }
      .seal-logo:active {
        background-color: #b91c1c;
        color: #fcfaf2;
      }
      .seal-mark {
        position: absolute;
        bottom: -0.5rem;
        right: -0.5rem;
        background-color: #b91c1c;
        color: #fcfaf2;
        font-size: 9px;
        padding: 0 0.25rem;
      }
    </style>
  </body>
</html>